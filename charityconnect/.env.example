# Copy to .env and export these (or set them in your shell). Placeholders only.
PORT=3000
DB_PATH=data/charityconnect.sqlite
NODE_ENV=development
# Set to your exact public frontend origin when the frontend is hosted separately.
# Example: FRONTEND_ORIGIN=https://OWNER.github.io
FRONTEND_ORIGIN=
# demo (default) = simulated payments; youpi = verified webhooks from a separately hosted YouPI-PG
PAYMENT_MODE=demo
YOUPI_WEBHOOK_SECRET=change-me
YOUPI_API_URL=http://localhost:6100
# Required only when seeding in production:
ADMIN_EMAIL=
ADMIN_PASSWORD=
